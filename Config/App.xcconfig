// `make` supplies the Release Please version and release build number.
#include "Project.xcconfig"
// x-release-please-start-version
APP_MARKETING_VERSION = 0.1.2
// x-release-please-end
APP_BUILD_NUMBER = 1

PRODUCT_NAME = GitBar
PRODUCT_BUNDLE_IDENTIFIER = com.GitBar.app
MARKETING_VERSION = $(APP_MARKETING_VERSION)
CURRENT_PROJECT_VERSION = $(APP_BUILD_NUMBER)
INFOPLIST_FILE = Config/Info.plist
GENERATE_INFOPLIST_FILE = NO

APP_COPYRIGHT = Copyright © 2026 pedrotmr
RELEASE_OWNER = pedrotmr
RELEASE_SLUG = git-bar
SPARKLE_ENABLED = YES
SPARKLE_FEED_URL = https:/$()/github.com/$(RELEASE_OWNER)/$(RELEASE_SLUG)/releases/latest/download/appcast.xml
SPARKLE_PUBLIC_ED_KEY = VUDvwV3+DXWYMPSVLvJ0IKCI7SllKT8MwDGDc7h8ytc=

CODE_SIGN_STYLE = Automatic
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS = NO
COMBINE_HIDPI_IMAGES = YES
ENABLE_PREVIEWS = YES
ENABLE_USER_SELECTED_FILES = readonly
REGISTER_APP_GROUPS = YES
STRING_CATALOG_GENERATE_SYMBOLS = YES
SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_STRICT_CONCURRENCY = minimal
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
